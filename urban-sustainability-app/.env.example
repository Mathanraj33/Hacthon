# ── Urban Sustainability App — environment variables ──────────────────────
# Copy this file to ".env" and fill in the values as your team gets them.
#   cp .env.example .env
#
# .env is git-ignored — never commit real keys. This .env.example file
# (with no real values) is safe to commit so the whole team has the list.

# ── City locked by the team (Phase 1, Hour 4 of the plan — do not change
#    once decided) ──
CITY_NAME=Chennai
CITY_LAT=13.0827
CITY_LON=80.2707

# ── data.gov.in — CPCB real-time AQI (India govt feed, "credibility anchor")
#    Register free: https://data.gov.in/user/register  (approval can take hours —
#    do this NOW per the plan, not on Day 9)
#    Resource: https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
CPCB_API_KEY=

# ── WAQI — World Air Quality Index (cross-check / fallback)
#    Register free: https://aqicn.org/data-platform/token/
#    "demo" works for initial testing without registering.
WAQI_API_TOKEN=demo

# Open-Meteo needs NO key — it's already wired and works with nothing set
# above. It's the automatic fallback if CPCB/WAQI aren't configured yet.
