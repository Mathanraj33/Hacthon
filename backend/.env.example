# Copy this to .env and fill in values
# ─────────────────────────────────────

# Database
# SQLite (default, works locally with zero setup):
DATABASE_URL=sqlite:///./sustainability.db

# PostgreSQL (Neon/Supabase/local) — uncomment and replace for staging/prod:
# DATABASE_URL=postgresql://user:password@host:5432/usas_db

# API Keys
DATA_GOV_IN_KEY=your_data_gov_in_api_key_here
WAQI_TOKEN=demo

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
